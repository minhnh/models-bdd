        },
        {
            "@id": "exec-pp:pickplace-exec-mockup", "@type": [ "bdd:ScenarioExecution", "bdd:SimulatedExecution" ],
            "of-variant": [
                "var:scr-var-pickplace", "var:scr-var-sorting"
            ],
            "has-behaviour-impl": "exec-pp:pickplace-bhv-mockup",
            "runs-scene": "exec-pp:pickplace-scene-inst"
        }
    ]
}
